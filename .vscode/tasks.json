{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build host",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/src/PcControl.Host/PcControl.Host.csproj", "-p:GenerateFullPaths=true", "-consoleloggerparameters:NoSummary"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/tests/PcControl.Tests", "-p:GenerateFullPaths=true", "-consoleloggerparameters:NoSummary"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$msCompile"
    }
  ]
}
