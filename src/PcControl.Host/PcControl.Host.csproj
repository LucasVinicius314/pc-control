<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>PcControl</AssemblyName>
    <RootNamespace>PcControl.Host</RootNamespace>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <WebDir>$(MSBuildThisFileDirectory)..\PcControl.Web\</WebDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PcControl.Core\PcControl.Core.csproj" />
    <ProjectReference Include="..\PcControl.Windows\PcControl.Windows.csproj" />
    <EmbeddedResource Include="Assets\app.ico" LogicalName="app.ico" />
    <InternalsVisibleTo Include="PcControl.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.13" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3719.77" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <!-- Build the phone page and embed it, so the PC side ships as one executable. -->
  <Target Name="BuildWeb" BeforeTargets="BeforeBuild" Condition="'$(SkipWebBuild)' != 'true'">
    <Exec Command="npm ci" WorkingDirectory="$(WebDir)" Condition="!Exists('$(WebDir)node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(WebDir)" />
  </Target>
  <Target Name="EmbedWeb" DependsOnTargets="BuildWeb" BeforeTargets="_CalculateEmbeddedFilesManifestInputs;AssignTargetPaths">
    <ItemGroup>
      <WebAsset Include="$(WebDir)dist\**" />
      <EmbeddedResource Include="@(WebAsset)" Link="web\%(WebAsset.RecursiveDir)%(WebAsset.Filename)%(WebAsset.Extension)" />
    </ItemGroup>
  </Target>
</Project>
